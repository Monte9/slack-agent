#!/usr/bin/env bash
# The slack-agent command. Service commands go to launchd; the rest run the bot in the foreground.
#   slack-agent start|stop|restart|status|logs   the background service
#   slack-agent install|uninstall                 add or remove the login item
#   slack-agent dev                               run in the foreground with hot reload (stop the service first)
#   slack-agent ask "question"                    one turn in the bot's session, without Slack
#   slack-agent scope                             rebuild the workspace and list the memory it shares
#   slack-agent watch                             mentions, turns, tool calls and errors as they happen
#   slack-agent read channels|history|thread|search   Slack as the bot sees it, for a turn that needs more than its thread
#   slack-agent upload <channel | message link> <file> [--comment <text>] [--broadcast]   post a local file as the bot
set -euo pipefail
# Commands run from the repo root, so a file argument resolves against the caller's directory.
export SLACK_AGENT_CWD="$PWD"
root="$(cd "$(dirname "$(readlink "$0" || echo "$0")")/.." && pwd)"
cd "$root"

case "${1:-}" in
  start|stop|restart|status|logs|install|uninstall)
    exec bash scripts/service.sh "$1"
    ;;
  dev)
    exec pnpm dev
    ;;
  ask|scope|watch|read|upload)
    exec pnpm -s "$1" "${@:2}"
    ;;
  *)
    sed -n '2,10p' "$0" | sed 's/^# \{0,3\}//'
    exit 2
    ;;
esac
