{
  "name": "slack-agent",
  "version": "0.1.0",
  "description": "A Slack bot that gives a local coding agent, and its memory, a persistent handle in your workspace.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "repository": "github:monte9/slack-agent",
  "bin": {
    "slack-agent": "scripts/slack-agent"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "service": "bash scripts/service.sh",
    "ask": "tsx src/cli.ts ask",
    "scope": "tsx src/cli.ts scope",
    "status": "tsx src/cli.ts status",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/**/*.test.ts"
  },
  "packageManager": "pnpm@10.33.0",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.276",
    "@slack/bolt": "^5.1.0",
    "@slack/types": "^3.1.0"
  },
  "devDependencies": {
    "@slack/cli-hooks": "^2.0.0",
    "@types/node": "^26.6.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
